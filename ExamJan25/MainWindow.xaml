<Window x:Class="ExamJan25.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamJan25"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85*"/>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="92*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="387*"/>
            <ColumnDefinition Width="413*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="1" Content="Tickets" HorizontalAlignment="Left" Margin="41,49,0,0" VerticalAlignment="Top"/>
        <Label Content="Events" HorizontalAlignment="Left" Margin="66,49,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="lbxEvents" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="66,10,10,14" Grid.Row="1" SelectionChanged="lbxEvents_SelectionChanged"/>
        <ListBox x:Name="lbxTickets" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,10,52,14" Grid.Row="1" Grid.Column="1"/>
        <TextBox HorizontalAlignment="Left" Margin="222,53,0,0" TextWrapping="Wrap" Text="Search" VerticalAlignment="Top" Width="155"/>
        <Label Grid.Column="1" Content="Number of Tickets" HorizontalAlignment="Left" Margin="73,253,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.RowSpan="2"/>
        <TextBox x:Name="tbxNumberOfTickets" Grid.Column="1" HorizontalAlignment="Left" Margin="194,257,0,0" Grid.Row="1" TextWrapping="Wrap" Text=" " VerticalAlignment="Top" Width="120" Grid.RowSpan="2"/>
        <Button x:Name="btnBook" Grid.Column="1" Content="Book" HorizontalAlignment="Left" Margin="330,257,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.RowSpan="2" Click="Button_Click"/>

    </Grid>
</Window>
